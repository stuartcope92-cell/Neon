# --- Supabase Postgres ------------------------------------------------------
# Both strings come from Supabase → Project Settings → Database → Connection string.
#
# Use the SESSION POOLER for both: port 5432 on ...pooler.supabase.com.
#
# Not the transaction pooler (:6543) — postgres.js pipelines queries and Supavisor's
# transaction mode deadlocks when two of them overlap, hanging every request.
# Not the direct connection (db.<ref>.supabase.co:5432) for DATABASE_URL either —
# it is IPv6-only and Vercel's functions cannot reach it.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Supabase Storage (company logo upload on /settings) --------------------
# Project Settings → API. The service-role key is server-side only — never expose it.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="branding"

# --- Admin login ------------------------------------------------------------
# Generate the hash with: npm run hash-password -- "your-password"
ADMIN_EMAIL="you@yourcompany.co.uk"
ADMIN_PASSWORD_HASH="scrypt:<salt>:<hash>"

# Random 32+ char string used to sign the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
